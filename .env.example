# Copy to .env.local (git-ignored) and fill in. Names only here: NEVER put real
# values in this file.
#
# Both variables are NEXT_PUBLIC_*, which means they are embedded in the
# JavaScript sent to every visitor. Only use:
#   - a Vapi PUBLIC key (never a private/secret key)
#   - the PUBLIC DEMO assistant ID (never the production assistant)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=

# --- Prophunters Market Planning sign-in (/dubai/*) ---
# Server-only (no NEXT_PUBLIC_ prefix). Set real values in .env.local, never here.
# PROPHUNTERS_SESSION_SECRET must be a random string of 32+ characters.
PROPHUNTERS_USERNAME=
PROPHUNTERS_PASSWORD=
PROPHUNTERS_SESSION_SECRET=
